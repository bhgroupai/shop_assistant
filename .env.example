TG_CHANNEL=your_channel   # username of the shop's public channel, without @
TG_API_ID=
TG_API_HASH=
TG_BOT_TOKEN=
TG_OWNER_ID=
# Gemini API key from Google AI Studio (free tier, no billing). Put the real key only in .env.
GEMINI_API_KEY=
# Ollama endpoint (embeddings only, until #23.5); on the GPU box itself use http://localhost:11434
OLLAMA_URL=http://localhost:11434
